{
  "name": "benchtop-riscv",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-based RISC-V emulator, from RV32I up to booting Linux.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @benchtop-riscv/web dev",
    "build": "pnpm -r build",
    "run:elf": "pnpm --filter \"@benchtop-riscv/machine...\" build && node scripts/run-elf.ts",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint . && depcruise packages tests && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:pages": "playwright test -c playwright.pages.config.ts"
  },
  "devDependencies": {
    "@benchtop-riscv/core": "workspace:*",
    "@benchtop-riscv/devices": "workspace:*",
    "@benchtop-riscv/elf": "workspace:*",
    "@benchtop-riscv/machine": "workspace:*",
    "@benchtop-riscv/riscv": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
